# Copy this file to `.env` and fill in your values (`.env` is git-ignored).
# Create a free Supabase project at https://supabase.com, then open:
#   Project Settings -> API  -> copy "Project URL" and "anon" key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Used ONLY by `npm run admin:setup` (never shipped to visitors' browsers).
# Project Settings -> API -> "service_role" key (keep it secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The email + password that unlocks the admin panel. Keep a strong password;
# it is stored in Supabase Auth and is never embedded in the website bundle.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password